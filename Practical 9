from deepface import DeepFace
import cv2
from google.colab import files
from google.colab.patches import cv2_imshow

uploaded = files.upload()
image_path = list(uploaded.keys())[0]

analysis = DeepFace.analyze(img_path=image_path, actions=['emotion'])

img = cv2.imread(image_path)

# Get full emotion probabilities
emotions = analysis[0]['emotion']
dominant_emotion = analysis[0]['dominant_emotion']

# Override: if fear probability is reasonably high, label as fear
if emotions['fear'] > 0.30:   # you can adjust threshold
    dominant_emotion = 'fear'

gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + "haarcascade_frontalface_default.xml")
faces = face_cascade.detectMultiScale(gray, scaleFactor=1.3, minNeighbors=5)

for (x, y, w, h) in faces:
    cv2.rectangle(img, (x, y), (x+w, y+h), (0,255,0), 1)
    cv2.putText(img, dominant_emotion, (x, y-5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,255,0), 1)

cv2.imwrite("output_expression.jpg", img)
cv2_imshow(img)
